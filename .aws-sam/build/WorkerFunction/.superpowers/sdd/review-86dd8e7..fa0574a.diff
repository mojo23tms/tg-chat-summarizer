 def recent_messages(conn, chat_id, n):
     cur = conn.execute(
         "SELECT user_name, text, ts FROM messages WHERE chat_id = ? "
         "ORDER BY ts DESC, id DESC LIMIT ?",
         (chat_id, n),
     )
     rows = [dict(r) for r in cur.fetchall()]
     rows.reverse()  # chronological oldest -> newest
     return rows
